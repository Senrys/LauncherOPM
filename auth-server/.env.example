# =============================================================================
#  One Piece Minecraft — serveur d'authentification
#  Copiez ce fichier en « .env » puis adaptez les valeurs.
#  Toutes les variables sont préfixées OPM_ et lues par opm_auth/config.py.
#
#  Les valeurs ci-dessous sont des valeurs de DÉVELOPPEMENT : le serveur REFUSE
#  de démarrer en production s'il en trouve encore une seule. Il énumère alors
#  tous les problèmes d'un coup, plutôt que de monter à moitié configuré.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Environnement d'exécution
# -----------------------------------------------------------------------------
# Environnement : dev | test | prod. Conditionne les contrôles de sécurité et
# la documentation interactive (/docs).
OPM_ENV=dev

# Adresse et port d'écoute d'uvicorn.
OPM_HOST=127.0.0.1
OPM_PORT=8000

# Niveau de journalisation : debug | info | warning | error.
OPM_LOG_LEVEL=info

# Trace SQL de SQLAlchemy dans la console (très bavard, développement seulement).
OPM_DEBUG_SQL=false

# URL publique du serveur, telle que le launcher et le jeu la voient.
# Sert à construire les URL de skins, de capes et les liens des courriels.
# En production, HTTPS est obligatoire.
OPM_PUBLIC_URL=http://127.0.0.1:8000

# Origines autorisées pour CORS, séparées par des virgules.
# Le launcher Electron n'en a pas besoin : laissez vide pour tout fermer.
OPM_CORS_ORIGINS=

# Faire confiance aux en-têtes X-Forwarded-For / X-Real-IP (mettre à true
# uniquement derrière un reverse proxy que VOUS contrôlez : sinon l'adresse IP
# utilisée par la limitation de débit devient falsifiable).
OPM_TRUST_PROXY_HEADERS=false

# Nombre de proxys de confiance placés DEVANT ce serveur.
#
# « X-Forwarded-For » est écrit par le CLIENT ; nginx se contente d'ajouter
# l'adresse réelle à la FIN de la chaîne. Lire la première entrée revient donc à
# croire l'attaquant sur parole : il lui suffit de changer la valeur à chaque
# requête pour obtenir un compteur neuf et contourner toutes les limites. Le
# serveur lit donc la chaîne EN PARTANT DE LA DROITE, en sautant ce nombre
# d'entrées.
#
#   1 = un nginx devant le serveur (cas le plus courant)
#   2 = un service de bordure (Cloudflare…) puis nginx
#
# Une valeur trop grande fait retomber sur l'adresse de connexion directe ;
# une valeur trop petite ferait confiance à une entrée écrite par le client :
# comptez les proxys pour de bon.
OPM_TRUSTED_PROXIES=1

# Adresses ou préfixes CIDR autorisés à poser ces en-têtes, séparés par des
# virgules. L'en-tête n'est lu QUE si la connexion arrive de l'un d'eux ; une
# requête venue d'Internet en direct ne peut donc rien affirmer sur son origine.
# Vide = boucle locale et réseaux privés (127.0.0.0/8, ::1, 10/8, 172.16/12,
# 192.168/16, fc00::/7…), ce qui couvre le nginx installé sur la même machine.
#   Exemple derrière un proxy dédié : OPM_TRUSTED_PROXY_IPS=10.0.0.4,10.0.0.5
OPM_TRUSTED_PROXY_IPS=

# -----------------------------------------------------------------------------
# 2. Base de données — CELLE DU SITE, pas une seconde base
# -----------------------------------------------------------------------------
# En production, cette URL pointe sur le PostgreSQL du site Flask. Le launcher
# lit les comptes, le journal de bord et les statistiques que le site tient
# déjà, et y ajoute ses propres tables (préfixes auth_, ygg_, launcher_).
#
# Le rôle PostgreSQL utilisé ici a besoin, et de rien de plus :
#   * tous droits sur les tables du launcher et leurs séquences :
#     auth_mc_link, auth_refresh_token, auth_totp, auth_recovery_code,
#     auth_password_reset, auth_ban, auth_audit, ygg_session, ygg_join,
#     texture, user_texture, launcher_instance ;
#   * SELECT sur les tables du site : users, article, statistiques,
#     equipages, iles ;
#   * INSERT sur users (+ USAGE sur users_id_seq) : le launcher crée des
#     comptes, qui sont des comptes du site à part entière ;
#   * UPDATE limité à users.derniereconnexion, users.tempsdejeu,
#     users.password_hash et aux colonnes de fréquentation de statistiques
#     (joueurs_en_ligne, record_joueurs, record_date).
#
# users.password_hash DOIT être accordé en écriture : c'est le renforcement
# transparent des empreintes (docs/DATA.md §3). Sans ce droit, tout compte
# historique échoue à la connexion ; sans INSERT, l'inscription répond
# « permission denied for table users ».
#
# Les colonnes RP (prime, berry, niveau*, faction, equipage…) appartiennent au
# site et au serveur Minecraft. Les retirer des droits du rôle est la meilleure
# garantie qu'une erreur de code ne pourra jamais les abîmer.
#
#   Développement : sqlite+aiosqlite:///./data/opm_auth.db
#   Production    : postgresql+asyncpg://opm_launcher:motdepasse@127.0.0.1:5432/opmdb
# (« sqlite:// » et « postgresql:// » sont convertis automatiquement vers leur
#  pilote asynchrone ; SQLite est refusé en production.)
OPM_DATABASE_URL=sqlite+aiosqlite:///./data/opm_auth.db

# Taille du pool de connexions (ignoré par SQLite). Le site consomme le sien de
# son côté : restez modeste pour ne pas saturer max_connections à deux.
OPM_DB_POOL_SIZE=10
OPM_DB_MAX_OVERFLOW=20

# -----------------------------------------------------------------------------
# 3. Secrets et clés cryptographiques
# -----------------------------------------------------------------------------
# Clé applicative générique (signature des états OAuth, dérivation de clés
# secondaires, chiffrement du secret TOTP). 32 caractères minimum.
# Génération : python -c "import secrets; print(secrets.token_urlsafe(48))"
OPM_SECRET_KEY=dev-only-secret-change-me-avant-la-mise-en-production

# Paire de clés Ed25519 signant les « access_token » de l'API launcher (JWT EdDSA).
# Génération :
#   openssl genpkey -algorithm ed25519 -out keys/jwt_ed25519_private.pem
#   openssl pkey -in keys/jwt_ed25519_private.pem -pubout -out keys/jwt_ed25519_public.pem
OPM_JWT_PRIVATE_KEY_PATH=keys/jwt_ed25519_private.pem
OPM_JWT_PUBLIC_KEY_PATH=keys/jwt_ed25519_public.pem

# Paire de clés signant les sessions Yggdrasil ET les propriétés « textures »
# des profils. C'est la clé publique publiée dans « signaturePublickey », celle
# que le serveur Minecraft (authlib-injector) vérifie.
#   openssl genpkey -algorithm ed25519 -out keys/ygg_ed25519_private.pem
#   openssl pkey -in keys/ygg_ed25519_private.pem -pubout -out keys/ygg_ed25519_public.pem
OPM_YGG_PRIVATE_KEY_PATH=keys/ygg_ed25519_private.pem
OPM_YGG_PUBLIC_KEY_PATH=keys/ygg_ed25519_public.pem

# Clé AES-256-GCM chiffrant au repos le « refresh_token » Microsoft de chaque
# joueur. 32 octets, en hexadécimal (64 caractères) ou en base64 (44 caractères).
# Génération : python -c "import secrets; print(secrets.token_hex(32))"
# ATTENTION : perdre cette clé oblige tous les joueurs à re-rattacher Microsoft.
OPM_MSA_TOKEN_KEY=6465762d6f6e6c792d6b65792d646f2d6e6f742d7573652d696e2d70726f6421

# Anciennes clés AES encore acceptées au DÉCHIFFREMENT, séparées par des
# virgules. Le temps d'une rotation : on chiffre avec la nouvelle, on relit avec
# les anciennes, puis on vide cette ligne. Format invalide = démarrage refusé.
OPM_MSA_TOKEN_KEYS_PREVIOUS=

# -----------------------------------------------------------------------------
# 4. Mots de passe — format Werkzeug, partagé avec le site
# -----------------------------------------------------------------------------
# Il n'y a PAS de réglage Argon2id, et c'est délibéré. Le site Flask hache avec
# werkzeug.security.generate_password_hash (pbkdf2:sha256). Si le serveur
# d'authentification réécrivait les empreintes dans un autre format, le site ne
# saurait plus vérifier les mots de passe et VOS JOUEURS NE POURRAIENT PLUS S'Y
# CONNECTER. Un compte, deux portes d'entrée, un seul format d'empreinte.
#
# Itérations PBKDF2-SHA256 à l'écriture. Le site lit le nombre d'itérations dans
# l'empreinte elle-même : le durcir ne lui demande aucune modification. À chaque
# connexion réussie, une empreinte plus faible est réécrite à cette valeur — le
# parc se renforce tout seul, sans jamais invalider un compte existant.
# 600000 est la recommandation OWASP, et le minimum accepté en production.
OPM_PASSWORD_ITERATIONS=600000

# Politique de robustesse appliquée aux NOUVEAUX mots de passe seulement
# (inscription et changement). Aucune invalidation rétroactive.
OPM_PASSWORD_MIN_LENGTH=12
OPM_PASSWORD_MAX_LENGTH=128

# Durée CONSTANTE d'une vérification de mot de passe, en millisecondes.
#
# Une empreinte du parc actuel (260 000 itérations) se vérifie en ~0,14 s, un
# compte inconnu coûtait ~0,34 s de calcul factice : l'écart suffisait à
# distinguer « ce compte existe » de « ce compte n'existe pas », donc à énumérer
# les adresses inscrites. Compte inconnu, empreinte illisible et mot de passe
# faux répondent désormais au bout du même délai, quoi qu'il arrive.
#
# 750 ms laissent de la marge au pire cas de vérification (600 000 itérations).
# Le renforcement d'une vieille empreinte se fait APRÈS cette fenêtre : il
# n'arrive qu'après un mot de passe juste et ne révèle donc rien. Un dépassement
# est signalé une fois dans les journaux.
# Mettre 0 pour désactiver l'attente (tests, ou parc plus coûteux que ce budget).
OPM_LOGIN_TIME_BUDGET_MS=750

# -----------------------------------------------------------------------------
# 5. Mode d'authentification
# -----------------------------------------------------------------------------
# sovereign  : compte OPM seul (aucune vérification Microsoft)
# hybrid     : compte OPM + Microsoft comme simple oracle de possession  <-- OPM
# microsoft  : Microsoft seul (mode de repli, non utilisé)
OPM_AUTH_MODE=hybrid

# Le rattachement Microsoft est-il obligatoire pour jouer ?
OPM_MICROSOFT_REQUIRED=true

# Les inscriptions sont-elles ouvertes ? (renvoyé par /api/v1/bootstrap)
OPM_REGISTRATION_OPEN=true

# L'adresse e-mail doit-elle être validée avant de pouvoir jouer ?
OPM_EMAIL_VERIFICATION_REQUIRED=false

# Durée de validité d'une vérification de possession Minecraft, en jours.
# Tant qu'elle n'est pas expirée, le joueur joue même si Microsoft est en panne.
# C'est le cœur de notre souveraineté : ne descendez pas sous 7 jours.
OPM_OWNERSHIP_TTL_DAYS=30

# -----------------------------------------------------------------------------
# 6. Microsoft / Xbox Live (oracle de possession)
# -----------------------------------------------------------------------------
# Identifiant client public du launcher Minecraft officiel.
# Aucune application Azure ne nous appartient : nous n'en avons pas besoin.
OPM_MSA_CLIENT_ID=00000000402b5328

# Secret client : vide pour un client public (le mode « device » n'en veut pas).
OPM_MSA_CLIENT_SECRET=

# Flux de rattachement : embedded (fenêtre Electron) | device (code à saisir).
#
# « device » est le seul flux utilisable avec une application Azure qui vous
# appartient : « embedded » repose sur l'ancien protocole Live Connect de
# login.live.com, réservé au client officiel de Mojang. Une application Azure
# moderne y est refusée.
#
# En « device », le joueur lit un code à six caractères et le saisit sur
# microsoft.com/link. Un clic de plus qu'une fenêtre intégrée, mais aucun
# code à écrire : le serveur implémente déjà les deux bouts.
OPM_MSA_FLOW=device

# URI de redirection du flux « embedded ». Le launcher détecte cette URL puis
# transmet le « code » au serveur : il n'échange jamais le code lui-même.
OPM_MSA_REDIRECT_URI=https://login.live.com/oauth20_desktop.srf

# Portées demandées à Microsoft (strict minimum pour lire le profil Minecraft).
OPM_MSA_SCOPE=service::user.auth.xboxlive.com::MBI_SSL
OPM_MSA_DEVICE_SCOPE=XboxLive.signin offline_access

# Préfixe du ticket RPS envoyé à Xbox Live.
#
# « d= » DANS TOUS LES CAS : flux « embedded » comme flux « device », client
# officiel comme application Azure personnelle. Le protocole d'Xbox Live impose
# ce préfixe pour reconnaître le format du ticket ; sans lui,
# user.auth.xboxlive.com répond 400 et le launcher affiche « Xbox Live a refusé
# la connexion de ce compte Microsoft ».
#
# (Une version antérieure de ce fichier prétendait qu'il fallait le vider pour
# le flux « device » : c'est faux, et ça coûte un rattachement impossible.)
#
# Ne changez ceci que si Microsoft modifie le protocole.
OPM_MSA_RPS_PREFIX=d=

# Points d'entrée Microsoft, configurables au cas où ils bougent.
OPM_MSA_AUTHORIZE_URL=https://login.live.com/oauth20_authorize.srf
OPM_MSA_TOKEN_URL=https://login.live.com/oauth20_token.srf
OPM_MSA_DEVICE_CODE_URL=https://login.microsoftonline.com/consumers/oauth2/v2.0/devicecode
OPM_MSA_DEVICE_TOKEN_URL=https://login.microsoftonline.com/consumers/oauth2/v2.0/token

# Chaîne de vérification : Xbox Live -> XSTS -> Minecraft Services.
OPM_XBL_AUTH_URL=https://user.auth.xboxlive.com/user/authenticate
OPM_XSTS_AUTH_URL=https://xsts.auth.xboxlive.com/xsts/authorize
OPM_MC_LOGIN_URL=https://api.minecraftservices.com/authentication/login_with_xbox
OPM_MC_PROFILE_URL=https://api.minecraftservices.com/minecraft/profile
OPM_MC_ENTITLEMENTS_URL=https://api.minecraftservices.com/entitlements/mcstore

# Délai maximal (secondes) des appels sortants vers Microsoft.
OPM_MSA_TIMEOUT_SECONDS=20

# -----------------------------------------------------------------------------
# 7. Durées de vie des jetons
# -----------------------------------------------------------------------------
# Jeton d'accès de l'API launcher (JWT EdDSA).
OPM_ACCESS_TTL_MINUTES=15

# Jeton de renouvellement opaque, rotatif, haché en base.
OPM_REFRESH_TTL_DAYS=30

# Session de jeu Yggdrasil remise au client Minecraft.
OPM_YGG_TTL_HOURS=24

# Validité d'une demande de « join » (session/minecraft/join -> hasJoined).
# Le protocole Mojang tolère très peu : 30 secondes suffisent.
OPM_JOIN_TTL_SECONDS=30

# Validité d'un lien de réinitialisation de mot de passe (minutes).
OPM_PASSWORD_RESET_TTL_MINUTES=30

# Nombre de codes de secours générés à l'activation de la 2FA.
OPM_RECOVERY_CODES_COUNT=10

# Émetteur et audiences des JWT. Laissez OPM_JWT_ISSUER vide : il retombe alors
# sur OPM_PUBLIC_URL (et OPM_TOTP_ISSUER sur OPM_SERVER_NAME).
OPM_JWT_ISSUER=
OPM_JWT_AUDIENCE=opm-launcher
OPM_JWT_GAME_AUDIENCE=opm-minecraft
# Tolérance d'horloge à la vérification des JWT, en secondes.
OPM_JWT_LEEWAY_SECONDS=5
OPM_TOTP_ISSUER=

# -----------------------------------------------------------------------------
# 8. Serveur Minecraft et identité Yggdrasil
# -----------------------------------------------------------------------------
# Nom affiché dans les métadonnées Yggdrasil (authlib-injector).
OPM_SERVER_NAME=One Piece Minecraft

# Adresse du serveur de jeu. L'adresse publiée aux joueurs vient de
# statistiques.server_ip ; celle-ci est celle que NOUS interrogeons.
OPM_MC_HOST=play.onepieceminecraft.fr
OPM_MC_PORT=25565

# Domaines autorisés à héberger les skins, séparés par des virgules.
# authlib-injector refuse toute texture servie hors de cette liste.
# En production : le domaine de OPM_PUBLIC_URL.
OPM_SKIN_DOMAINS=127.0.0.1,localhost

# Dossier de stockage des textures (contenu adressable par SHA-256).
OPM_TEXTURES_DIR=data/textures

# Taille maximale d'un skin téléversé, en kilo-octets.
OPM_TEXTURE_MAX_KIB=256

# Repli sur le sessionserver de Mojang quand « hasJoined » reçoit un pseudo
# inconnu de notre base : les joueurs premium venus du launcher OFFICIEL entrent
# alors sur le serveur. À laisser false en mode « hybride imposé » — c'est ce
# réglage qui rend le launcher obligatoire.
OPM_YGG_MOJANG_FALLBACK=false

# -----------------------------------------------------------------------------
# 9. Fréquentation du serveur (écriture dans « statistiques »)
# -----------------------------------------------------------------------------
# Le serveur d'authentification ping le serveur Minecraft et écrit le résultat
# dans la ligne unique « statistiques » (id = 1), en UNE instruction atomique
# protégée par GREATEST. Le site fait le même relevé de son côté : aucun des
# deux ne peut écraser le record de l'autre. Si le ping échoue, RIEN n'est
# écrit — on ne remplace jamais une valeur connue par un zéro sur un timeout.
#
# Mettre à false si le site reprend seul la main sur ces colonnes.
OPM_STATS_WRITE=true

# Cadence du relevé, en secondes.
OPM_STATS_INTERVAL=20

# -----------------------------------------------------------------------------
# 10. Mises à jour du launcher
# -----------------------------------------------------------------------------
# Version minimale acceptée : en dessous, le launcher se bloque et met à jour.
OPM_LAUNCHER_VERSION_MIN=2.0.0
OPM_LAUNCHER_VERSION_LATEST=2.0.0

# Repli seulement : les URL de téléchargement réelles sont dans
# statistiques.launcher_windows / _mac / _linux, tenues par le site.
OPM_LAUNCHER_DOWNLOAD_URL=https://onepieceminecraft.fr/telechargement

# Maintenance : quand active, le bouton JOUER affiche « INDISPONIBLE ».
OPM_MAINTENANCE_ACTIVE=false
OPM_MAINTENANCE_MESSAGE=
# Fin de maintenance estimée, au format ISO-8601 UTC (ex. 2026-09-08T18:00:00Z).
OPM_MAINTENANCE_ETA=

# -----------------------------------------------------------------------------
# 11. Liens du rail social (bloc « links » de /api/v1/bootstrap)
# -----------------------------------------------------------------------------
OPM_LINK_DISCORD=https://discord.gg/ekDKBDFfda
OPM_LINK_TWITCH=https://www.twitch.tv/onepieceminecraftfr
OPM_LINK_YOUTUBE=https://www.youtube.com/@onepieceminecraftfr457
OPM_LINK_WEBSITE=https://onepieceminecraft.fr

# Adresse publique du site Flask, base des liens du journal de bord. La table
# « article » ne stocke que le slug de chaque billet ; c'est cette valeur qui
# en fait une adresse que le launcher peut ouvrir.
OPM_SITE_URL=https://onepieceminecraft.fr

# -----------------------------------------------------------------------------
# 12. Contenu du launcher
# -----------------------------------------------------------------------------
# Nombre d'articles renvoyés par défaut par GET /api/v1/news. Le JOURNAL DE BORD
# est alimenté par la table « article » du site : il n'y a pas de flux RSS à
# configurer, ni de seconde source à tenir à jour.
OPM_NEWS_LIMIT=10

# Source du manifeste d'instances servi par /api/v1/instances.
# Vide = les instances sont lues dans la table launcher_instance.
OPM_INSTANCES_URL=

# Durée de mise en cache du contenu distant, en secondes.
OPM_CONTENT_CACHE_SECONDS=120

# -----------------------------------------------------------------------------
# 13. Dons
# -----------------------------------------------------------------------------
# Il n'y a AUCUNE table de dons et AUCUN paiement dans le launcher : la partie
# paiement du site n'est pas terminée. L'écran Donation lit uniquement
# statistiques.dons_collecte, dons_objectif et donateurs — des chiffres réels,
# déjà tenus par le site — et en déduit les quatre paliers. Le classement des
# donateurs n'a pas de source : il affiche un état vide honnête plutôt que de
# faux donateurs.
#
# Le bouton « FAIRE UN DON » ouvre simplement cette page dans le navigateur.
OPM_DONATION_URL=https://onepieceminecraft.fr/don

# -----------------------------------------------------------------------------
# 14. Courriel (réinitialisation de mot de passe, vérification d'adresse)
# -----------------------------------------------------------------------------
# À false, les courriels sont écrits dans le journal au lieu d'être envoyés.
OPM_SMTP_ENABLED=false
OPM_SMTP_HOST=localhost
OPM_SMTP_PORT=587
OPM_SMTP_USER=
OPM_SMTP_PASSWORD=
OPM_SMTP_FROM=no-reply@onepieceminecraft.fr
OPM_SMTP_FROM_NAME=One Piece Minecraft
# STARTTLS sur le port 587, ou TLS implicite sur le port 465. Pas les deux.
OPM_SMTP_STARTTLS=true
OPM_SMTP_SSL=false
OPM_SMTP_TIMEOUT_SECONDS=15

# -----------------------------------------------------------------------------
# 15. Limitation de débit
# -----------------------------------------------------------------------------
OPM_RATE_LIMIT_ENABLED=true

# Stockage des compteurs : memory:// en développement,
# redis://127.0.0.1:6379/0 en production multi-processus.
OPM_RATE_LIMIT_STORAGE_URI=memory://

# Format « nombre/période » : second, minute, hour, day.
OPM_RATE_LIMIT_DEFAULT=120/minute
OPM_RATE_LIMIT_LOGIN_IP=5/minute
OPM_RATE_LIMIT_LOGIN_ACCOUNT=10/hour
OPM_RATE_LIMIT_REGISTER=3/hour
OPM_RATE_LIMIT_FORGOT=3/hour
OPM_RATE_LIMIT_YGGDRASIL=10/minute
