# ============================================================================
#  OPM Launcher — variables d'environnement
# ----------------------------------------------------------------------------
#  Copiez ce fichier en `.env` et adaptez-le. `.env` ne doit JAMAIS être
#  versionné : il contient des mots de passe de certificat.
#
#  Ce fichier n'est pas lu automatiquement par le launcher : Electron n'a pas
#  de chargeur `.env` et nous n'ajoutons pas de dépendance pour ça. Il sert de
#  documentation, et de source pour votre shell :
#
#      PowerShell   Get-Content .env | ForEach-Object { if ($_ -match '^\s*([^#=]+)=(.*)$') { [Environment]::SetEnvironmentVariable($matches[1].Trim(), $matches[2].Trim()) } }
#      bash / zsh   set -a && . ./.env && set +a
#
#  En production, les valeurs de signature vivent dans les secrets GitHub
#  Actions (voir .github/workflows/release.yml), jamais sur un disque.
# ============================================================================


# ─────────────────────────────────────────────────────────── EXÉCUTION (dev)
# Ces trois variables ne concernent que le développement. Un launcher compilé
# n'en a aucune : il utilise les valeurs par défaut du code.

# Bascule le launcher en mode développement : les données (comptes, coffre,
# journaux, jeu) restent dans `./data` à côté des sources au lieu du profil
# utilisateur. `npm start` et `npm run dev` la positionnent déjà.
# NODE_ENV=development

# Ouvre les outils de développement Chromium au démarrage de la fenêtre.
# `npm run dev` la positionne déjà.
# DEV_TOOL=open

# Redirige le launcher vers un autre serveur d'authentification. Sans elle,
# il interroge https://auth.onepieceminecraft.fr (voir src/main/auth/api.js).
# Indispensable pour travailler contre l'auth-server lancé en local.
# OPM_API_URL=http://127.0.0.1:8000


# ────────────────────────────────────────────────── PUBLICATION DES VERSIONS
# Nécessaire uniquement pour `node build.js --publish=always`.

# Jeton GitHub avec la permission `repo`, utilisé par electron-builder pour
# créer la release et y téléverser les binaires + les fichiers latest*.yml.
# Dans GitHub Actions, `secrets.GITHUB_TOKEN` suffit et est fourni d'office.
# GH_TOKEN=


# ───────────────────────────────────────────────── SIGNATURE — WINDOWS
# Toutes facultatives : sans elles la compilation réussit et produit un
# installeur NON signé (SmartScreen affichera « Éditeur inconnu »).
# Voir docs/BUILD.md § 4.1 pour le choix du certificat.

# Certificat au format PFX/P12 : chemin local, ou contenu encodé en base64
# (c'est la forme attendue par un secret GitHub Actions).
# WIN_CSC_LINK=
# WIN_CSC_KEY_PASSWORD=

# Variante Azure Trusted Signing (~10 $/mois, réputation immédiate, mais exige
# 3 ans d'existence vérifiable de l'organisation). Les trois vont ensemble.
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=


# ───────────────────────────────────────────────── SIGNATURE — macOS
# Sans ces variables, l'application est non signée et Gatekeeper refuse
# purement et simplement de l'ouvrir. Il n'y a pas de contournement simple
# pour un joueur (docs/BUILD.md § 4.2).

# Certificat « Developer ID Application », base64 du .p12, et son mot de passe.
# CSC_LINK=
# CSC_KEY_PASSWORD=

# Notarisation. Les trois sont requises ensemble ; l'une manquante et
# build.js désactive la notarisation en le disant en console.
# APPLE_APP_SPECIFIC_PASSWORD se crée sur appleid.apple.com, ce n'est jamais
# le mot de passe du compte Apple lui-même.
# APPLE_ID=
# APPLE_APP_SPECIFIC_PASSWORD=
# APPLE_TEAM_ID=


# ───────────────────────────────────────────────── SIGNATURE — LINUX
# Il n'existe pas d'infrastructure de confiance équivalente. La pratique est
# de publier `SHA256SUMS` (build.js le génère seul) et une signature GPG
# détachée, faite à la main avec la clé du serveur :
#
#     gpg --armor --detach-sign --output dist/SHA256SUMS.asc dist/SHA256SUMS
#
# La clé publique est ensuite déposée sur onepieceminecraft.fr.
