# Régénère le manifeste « files.json » du modpack.
#
# Déclenché par opm-files-json.timer. Vous n'avez jamais à le lancer à la main :
# déposez vos mods dans /var/www/opm-launcher/ et le manifeste suit tout seul.
#
# Le générateur est incrémental : il garde les empreintes des fichiers dont la
# taille et la date n'ont pas changé. Un passage sans modification ne lit aucun
# octet, et l'ajout d'un mod ne hache que ce mod.

[Unit]
Description=Génération du manifeste files.json du modpack OPM
After=network.target

[Service]
Type=oneshot

# Le compte qui DÉPOSE les fichiers, pas celui de nginx.
#
# Les fichiers arrivent par scp sous votre compte, en 644 : nginx (www-data) les
# LIT sans difficulté grâce au bit « autres ». Le générateur, lui, doit ÉCRIRE
# files.json — s'il tourne en www-data, il se heurte à un fichier appartenant à
# votre compte et échoue sur « Permission denied », à chaque téléversement.
#
# Faire tourner le générateur sous le compte déposant supprime le problème à la
# racine, au lieu de rejouer un « chown -R » après chaque envoi.
#
# À ADAPTER si vous déposez sous un autre compte que « debian ».
User=debian
Group=debian
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /opt/opm-auth/scripts/build-files-json.py \
          /var/www/opm-launcher \
          https://auth.onepieceminecraft.fr/launcher

# Le script n'écrit que dans le dossier du modpack.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=tmpfs
# Le « - » rend le chemin facultatif au montage. Sans lui, si le dossier
# n'existe pas encore, systemd refuse de créer l'espace de noms et le service
# meurt sur un « 226/NAMESPACE » opaque, AVANT même de lancer Python. Avec, le
# service démarre et c'est le script qui dit clairement « Dossier introuvable ».
ReadWritePaths=-/var/www/opm-launcher
